// Anime4K-v3.2-Upscale-CNN-x2-(VL)-Depth-to-Space
kernel void upscale_vl_p17(texture2d<float, access::sample> t0 [[texture(0)]],
    texture2d<float, access::sample> t1 [[texture(1)]],
    texture2d<float, access::sample> t2 [[texture(2)]],
    texture2d<float, access::sample> t3 [[texture(3)]],
    texture2d<float, access::write> outTex [[texture(4)]],
    uint2 gid [[thread_position_in_grid]]) {
    const uint w = outTex.get_width(), h = outTex.get_height();
    if (gid.x >= w || gid.y >= h) return;
    const uint2 lo = gid / 2;
    const uint ch = (gid.y & 1) * 2 + (gid.x & 1);
    const float l1 = t1.read(lo)[ch];
    const float l2 = t2.read(lo)[ch];
    const float l3 = t3.read(lo)[ch];
    const float2 pos = (float2(gid) + 0.5f) / float2(w, h);
    const float4 base = t0.sample(linearClamp, pos);
    outTex.write(float4(l1, l2, l3, l3) + base, gid);
}
